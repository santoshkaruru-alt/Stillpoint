{
  "expo": {
    "name": "Stillpoint",
    "slug": "stillpoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stillpoint",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07071A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stillpoint.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07071A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#9C8CFF"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Stillpoint",
      "shortName": "Stillpoint",
      "description": "Guided meditation and breathwork",
      "themeColor": "#07071A",
      "backgroundColor": "#07071A"
    }
  }
}
