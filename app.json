{
  "expo": {
    "name": "Becoming",
    "slug": "stillpoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stillpoint",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EDF3F6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stillpoint.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF3F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#091925",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#1C6A86"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Becoming",
      "shortName": "Becoming",
      "description": "Guided meditation and breathwork",
      "themeColor": "#EDF3F6",
      "backgroundColor": "#EDF3F6"
    }
  }
}
